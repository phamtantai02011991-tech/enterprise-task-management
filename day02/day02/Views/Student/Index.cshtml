@model day02.Model.ViewModels.StudentViewModel

@{
    ViewData["Title"] = "Student List";
}

<h1>Student List</h1>

<a asp-controller="Student"
   asp-action="Create"
   class="btn btn-primary">
    Add Student
</a>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Age</th>
            <th>Gmail</th>
            <th>Phone</th>
            <th>Mark</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var student in Model.Students)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.Name</td>
                <td>@student.Age</td>
                <td>@student.Gmail</td>
                <td>@student.Phone</td>
                <td>@student.Mark</td>
            </tr>
        }
    </tbody>
</table>