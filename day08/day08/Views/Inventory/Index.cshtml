@model IEnumerable<day08.Core.ViewModels.ProductViewModel>

<div class="container">
    @if (TempData["SuccessMsg"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMsg"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Danh Sách Quản Lý Tồn Kho</h4>
            <a asp-action="StockTransaction" class="btn btn-light text-primary font-weight-bold">
                + Nhập / Xuất Kho
            </a>
        </div>
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center" style="width: 100px;">Mã SP</th>
                        <th>Tên Sản Phẩm</th>
                        <th class="text-center">Tồn Kho</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-end">Đơn Giá</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.OutOfStock ? "table-danger" : (item.IsLowStock ? "table-warning" : ""))">
                            <td class="text-center">@item.Id</td>
                            <td><strong>@item.Name</strong></td>
                            <td class="text-center font-weight-bold">@item.StockQuantity</td>
                            <td class="text-center">
                                @if (item.OutOfStock)
                                {
                                    <span class="badge bg-danger">Hết hàng</span>
                                }
                                else if (item.IsLowStock)
                                {
                                    <span class="badge bg-warning text-dark">Sắp hết hàng</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Còn hàng</span>
                                }
                            </td>
                            <td class="text-end font-weight-bold">@item.Price.ToString("N0") $</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>