@using day08.Core.Entities
@model day08.Core.ViewModels.StockTransactionViewModel

<div class="container">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Tạo Phiếu Nhập / Xuất Kho</h4>
        </div>
        <div class="card-body">
            <form asp-action="StockTransaction" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Type" class="form-label font-weight-bold">Loại Giao Dịch</label>
                    <select asp-for="Type" class="form-select">
                        <option value="@TransactionType.Export">Xuất Kho</option>
                        <option value="@TransactionType.Import">Nhập Kho</option>
                    </select>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProductId" class="form-label font-weight-bold">Chọn Sản Phẩm</label>
                    <select asp-for="ProductId" class="form-select"
                            asp-items="@(new SelectList(ViewBag.Products, "Id", "Name"))">
                    </select>
                    <span asp-validation-for="ProductId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label font-weight-bold">Số Lượng</label>
                    <input asp-for="Quantity" type="number" class="form-control" min="1" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Note" class="form-label font-weight-bold">Ghi Chú</label>
                    <textarea asp-for="Note" class="form-control" rows="2" placeholder="Nhập ghi chú nếu có..."></textarea>
                    <span asp-validation-for="Note" class="text-danger"></span>
                </div>

                <div>
                    <a asp-action="Index" class="btn btn-secondary me-2">Quay lại</a>
                    <button type="submit" class="btn btn-success">Xác Nhận</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}