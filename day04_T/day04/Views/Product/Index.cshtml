@model day04.ViewModels.ProductIndexViewModel
@{
	ViewData["title"] = "Index";
}
<div class="container">
	<div>
		<h1>Product Management System</h1>
		<div>
			<a asp-action="Create" class="btn btn-success">+ Add New</a>
		</div>
	</div>
	<br/>
	<partial name="_pvProduct" model="Model.Statistics"/>
	<br/>
	<form asp-action="Index" method="get" class="row">
		<input type="text" name="keyword" value="@Model.Keyword" size="30"/>
		<button type="submit" class="btn btnalert-primary"/>
	</form>
	<br/>
	<table class="table">
		<tr>
			<th>Image</th>
			<th>Id</th>
			<th>Product Name</th>
			<th>Category</th>
			<th>Unit Price</th>
			<th>Quantity</th>
			<th>Actions</th>
		</tr>
		@foreach(var product in Model.Products)
		{
			<tr>
				<td>
					@if (!string.IsNullOrEmpty(product.ImagePath))
					{
						<img src="@product.ImagePath" width="80" height="80"/>
					}
					else
					{
						<span>No Image</span>
					}
				</td>
				<td>@product.Id</td>
				<td>@product.Name</td>
				<td>@product.Category</td>
				<td>@product.Price</td>
				<td>@product.Quantity</td>
				<td>
					<a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-warning">Edit</a>
					<a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-danger">Delete</a>
				</td>
			</tr>
		}
	</table>
</div>