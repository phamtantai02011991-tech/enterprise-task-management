@model day03.DTOs.StudentScoreDto
@{
    ViewData["Title"] = "Score update";
}

<div class="container">
    <div>
        <h4>Update Student Grades</h4>
    </div>
    <div>
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="ScoreId" />

            <div>
                <label asp-for="StudentId">Student ID</label>
                <input asp-for="StudentId" value="@Model.StudentId" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="StudentName">Student Name</label>
                <input asp-for="StudentName" value="@Model.StudentName" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="SubjectName">Subject</label>
                <input asp-for="SubjectName" value="@Model.SubjectName" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="Score" >Score (0 - 10)</label>
                <input asp-for="Score" type="number" step="0.01" min="0" max="10" />
                <span asp-validation-for="Score" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <a asp-action="Index">Back to List</a>
                <button type="submit">Save</button>
            </div>
        </form>
    </div>
</div>
