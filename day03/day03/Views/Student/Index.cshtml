@model day03.DTOs.StudentViewModel

@{
	TempData["title"] = "Student Score";
}

<div class="container">
	<div>
		<h3>Student Grade List</h3>
		<form asp-action="Index" method="get">
			<label asp-for="Filter.SearchKeyword">Search</label>
			<input asp-for="Filter.SearchKeyword" />
			<label asp-for="Filter.SubjectId">Subject</label>
			<select asp-for="Filter.SubjectId" asp-items="@Model.Subjects">
				<option value="">---All subjects---</option>
			</select>
			<button type="submit" class="btn btn-primary">Filter</button>
		</form>
	</div>

	<div>
		<table class="table">
			<tr>
				<th>Student ID</th>
				<th>Student Name</th>
				<th>Subject</th>
				<th>Score</th>
				<th>Actions</th>
			</tr>
			@foreach(var item in Model.Scores)
			{
				<tr>
					<td>@item.StudentId</td>
					<td>@item.StudentName</td>
					<td>@item.SubjectName</td>
					<td>
					 <span class="badge @(item.Score >= 5.0m ? "bg-success" : "bg-danger")">
						 @item.Score
					 </span> 
					</td>
					<td>
						<a asp-action="Edit" asp-route-id="@item.ScoreId">Update</a>
					</td>
				</tr>
			}
		</table>
	</div>
</div>