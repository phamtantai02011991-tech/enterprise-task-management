@{
    var isManager = User.IsInRole("Manager");
    var isAdmin = User.IsInRole("Admin");
    var isEmployee = User.IsInRole("Employee");
    var userArea = isAdmin ? "Admin" : isManager ? "Manager" : "Employee";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskManagement SaaS</title>

    <!-- Google Fonts Poppins & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- Premium Glassmorphism CSS -->
    <link rel="stylesheet" href="~/css/glassmorphism.css" />
</head>

<body>

    <div class="ambient-bg">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
    </div>


    <header class="glass-header">
        <a class="brand-logo-container" asp-area="@userArea" asp-controller="Dashboard" asp-action="Index">
            <img src="~/images/logo.png" alt="TaskManagement Logo" class="brand-logo-img" />
            <span class="brand-text">TaskManagement</span>
        </a>


        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <form asp-controller="Search" asp-action="Index" method="get"
                  class="glass-search-box ms-4 d-none d-md-block position-relative">

                <input type="text"
                       name="q"
                       class="glass-search-input"
                       placeholder="Search tasks, projects..."
                       required />

                <button type="submit" class="glass-search-btn" title="Search">
                    <i class="bi bi-search fs-6 text-primary"></i>
                </button>
            </form>
        }


        <div class="ms-auto d-flex align-items-center gap-3">

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <!-- Notification Bell Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-light rounded-circle p-2 shadow-sm border-0 position-relative" type="button" id="notifDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                        <i class="bi bi-bell-fill fs-5 text-secondary"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" id="notifBadgeCounter">
                            0
                        </span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-0" style="width: 340px;" aria-labelledby="notifDropdownBtn">
                        <div class="p-3 bg-light rounded-top-4 d-flex justify-content-between align-items-center border-bottom">
                            <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-bell text-primary me-2"></i>Thông báo</h6>
                            <a asp-area="" asp-controller="Notification" asp-action="Index" class="small text-primary text-decoration-none">Xem tất cả</a>
                        </div>
                        <div class="p-2" id="notifDropdownList" style="max-height: 280px; overflow-y: auto;">
                            <div class="text-center py-3 text-muted small">Đang tải thông báo...</div>
                        </div>
                        <div class="p-2 text-center border-top bg-light rounded-bottom-4">
                            <a asp-area="" asp-controller="Notification" asp-action="Preferences" class="small text-muted text-decoration-none">
                                <i class="bi bi-sliders me-1"></i> Cài đặt thông báo
                            </a>
                        </div>
                    </div>
                </div>


                <div class="d-flex align-items-center gap-2 ps-2 border-start">

                    <img src="https://ui-avatars.com/api/?name=@(User.Identity.Name)&background=2563EB&color=fff&rounded=true"
                         alt="Avatar"
                         class="rounded-circle shadow-sm"
                         width="38"
                         height="38" />

                    <div class="d-none d-lg-block">

                        <div class="fw-bold fs-7 leading-tight">
                            @User.Identity.Name
                        </div>

                        <span class="badge bg-primary bg-opacity-10 text-primary small p-1">
                            @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                        </span>

                    </div>
                </div>


                <form asp-area=""
                      asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="d-inline">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-outline-danger btn-sm rounded-pill px-3 ms-2"
                            title="Logout">

                        <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất

                    </button>

                </form>
            }
            else
            {
                <a class="btn btn-outline-primary btn-sm px-3 rounded-pill"
                   asp-area="" asp-controller="Account" asp-action="Login">
                    Login
                </a>

                <a class="btn btn-primary btn-sm px-3 rounded-pill"
                   asp-area="" asp-controller="Account" asp-action="Register">
                    Register
                </a>
            }

        </div>
    </header>



    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {

        <nav class="glass-sidebar">

            <div class="sidebar-heading">
                MAIN NAVIGATION
            </div>


            <div class="nav flex-column mb-3">

                <a class="sidebar-nav-link"
                   asp-area="@userArea" asp-controller="Dashboard" asp-action="Index">

                    <i class="bi bi-grid-1x2-fill"></i>
                    Dashboard

                </a>


                <a class="sidebar-nav-link"
                   asp-area="@userArea" asp-controller="Project" asp-action="Index">

                    <i class="bi bi-folder-fill"></i>
                    Projects

                </a>


                <a class="sidebar-nav-link"
                   asp-area="@userArea" asp-controller="Task" asp-action="Index">

                    <i class="bi bi-check2-square"></i>
                    Tasks

                </a>


                <a class="sidebar-nav-link"
                   asp-area="" asp-controller="DirectChat" asp-action="Index">

                    <i class="bi bi-chat-dots-fill text-primary"></i>
                    Direct Chat Messenger

                    <span class="sidebar-badge">
                        Live
                    </span>

                </a>

            </div>



            <div class="sidebar-heading">
                ENTERPRISE TOOLS
            </div>


            <div class="nav flex-column mb-3">

                @if (isManager || isAdmin)
                {
                    <a class="sidebar-nav-link"
                       asp-area="Manager" asp-controller="TimeLog" asp-action="Index">

                        <i class="bi bi-clock-history"></i>
                        Nhật ký Thời gian (Time Logs)

                    </a>
                }


                <a class="sidebar-nav-link"
                   asp-area="" asp-controller="Notification" asp-action="Index">

                    <i class="bi bi-bell-fill"></i>
                    Notifications

                </a>


                @if (isAdmin)
                {
                    <a class="sidebar-nav-link"
                       asp-area="Admin" asp-controller="User" asp-action="Index">

                        <i class="bi bi-people-fill"></i>
                        Quản lý Người dùng

                    </a>

                    <a class="sidebar-nav-link"
                       asp-area="Admin" asp-controller="Department" asp-action="Index">

                        <i class="bi bi-building"></i>
                        Quản lý Phòng ban

                    </a>

                    <a class="sidebar-nav-link"
                       asp-area="Admin" asp-controller="AuditLog" asp-action="Index">

                        <i class="bi bi-journal-text"></i>
                        Nhật ký Audit Logs

                    </a>
                }

            </div>

        </nav>

    }



@inject TaskManagementWeb.Services.Admin.IAdminAnnouncementService AnnouncementService
    <main class="glass-main-wrapper @(User.Identity != null && User.Identity.IsAuthenticated ? "" : "m-0 pt-5")">

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            var activeAnnouncements = await AnnouncementService.GetActiveAnnouncementsAsync();
            if (activeAnnouncements != null && activeAnnouncements.Any())
            {
                foreach (var ann in activeAnnouncements.Take(2))
                {
                    <div class="alert @(ann.Type == "Urgent" ? "alert-danger" : ann.Type == "Warning" ? "alert-warning" : "alert-primary") alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
                        <div class="me-3 fs-4">
                            @if (ann.Type == "Urgent")
                            {
                                <i class="bi bi-exclamation-octagon-fill text-danger"></i>
                            }
                            else if (ann.Type == "Warning")
                            {
                                <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                            }
                            else
                            {
                                <i class="bi bi-megaphone-fill text-primary"></i>
                            }
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2">
                                <strong class="fw-bold">@ann.Title</strong>
                                @if (ann.IsPinned)
                                {
                                    <span class="badge bg-danger rounded-pill"><i class="bi bi-pin-angle-fill me-1"></i>Ghim</span>
                                }
                            </div>
                            <div class="small mt-1">@ann.Content</div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            }
        }


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4">

                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }


        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }


        @RenderBody()

    </main>



    <footer class="glass-footer">
        <div>
            <strong>TaskManagement SaaS</strong> &copy; 2026.
            <span class="ms-3 text-primary d-none d-md-inline fw-semibold">
                <i class="bi bi-person-circle me-1"></i> Developed by Pham Tan Tai
            </span>
        </div>

        <div>
            <a href="#docs"><i class="bi bi-book me-1"></i>Documentation</a>
            <a href="#privacy"><i class="bi bi-shield-check me-1"></i>Privacy</a>
            <a href="#support"><i class="bi bi-headset me-1"></i>Support</a>
        </div>
    </footer>



    <!-- Core JS Libraries -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
    function loadNotifications() {
        fetch('/Notification/GetUnreadSummary')
            .then(res => res.json())
            .then(data => {
                const badge = document.getElementById('notifBadgeCounter');
                const list = document.getElementById('notifDropdownList');
                if (badge && data.unreadCount > 0) {
                    badge.textContent = data.unreadCount;
                    badge.classList.remove('d-none');
                } else if (badge) {
                    badge.classList.add('d-none');
                }

                if (list && data.items) {
                    if (data.items.length === 0) {
                        list.innerHTML = '<div class="text-center py-3 text-muted small">Không có thông báo mới</div>';
                    } else {
                        list.innerHTML = data.items.map(item => `
                            <div class="p-2 border-bottom ${item.isRead ? '' : 'bg-light'} rounded-3 mb-1">
                                <div class="fw-semibold small text-dark">${item.title}</div>
                                <div class="small text-secondary text-truncate" style="max-width: 300px;">${item.message}</div>
                                <small class="text-muted fs-8">${item.timeAgo}</small>
                            </div>
                        `).join('');
                    }
                }
            }).catch(() => {});
    }
    document.addEventListener('DOMContentLoaded', function() {
        loadNotifications();
        setInterval(loadNotifications, 30000);
    });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
