@model TaskManagementWeb.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Đăng Nhập Hệ Thống";
}

<div class="container py-4 my-auto">
    <div class="row justify-content-center align-items-center">
        <div class="col-xxl-11 col-12">
            <div class="card border-0 shadow-2xl rounded-5 overflow-hidden bg-white" style="min-height: 740px;">
                <div class="row g-0 h-100" style="min-height: 740px;">
                    
                    <!-- LEFT COLUMN: VIDEO INTRO (RAJPHAM R-LOGO 10S LOOP) -->
                    <div class="col-lg-6 position-relative d-flex flex-column justify-content-between p-4 overflow-hidden rounded-start-5"
                         style="min-height: 740px; background: radial-gradient(circle at center, #1e293b 0%, #090d16 100%);">
                        
                        <!-- Video Player (100% video view on loop) -->
                        <video id="introVideo"
                               src="/videos/intro.mp4"
                               class="w-100 h-100 position-absolute top-0 start-0"
                               style="object-fit: contain;"
                               autoplay
                               loop
                               muted
                               playsinline
                               preload="auto">
                            <source src="/videos/intro.mp4" type="video/mp4" />
                        </video>

                        <!-- Top Controls: Badge 10s Loop & Sound Toggle -->
                        <div class="position-relative d-flex justify-content-between align-items-center" style="z-index: 10;">
                            <span class="badge bg-danger rounded-pill px-3 py-2 shadow-lg d-flex align-items-center gap-2 fs-7">
                                <span class="spinner-grow spinner-grow-sm text-light" style="width: 8px; height: 8px;" role="status"></span>
                                INTRO DEMO • 10S LOOP
                            </span>
                            <button type="button"
                                    id="toggleSoundBtn"
                                    class="btn btn-dark bg-opacity-75 text-white border-0 rounded-circle shadow-lg d-flex align-items-center justify-content-center"
                                    style="width: 42px; height: 42px;"
                                    title="Bật/Tắt âm thanh"
                                    onclick="toggleAudio()">
                                <i class="bi bi-volume-mute-fill fs-5" id="soundIcon"></i>
                            </button>
                        </div>

                        <!-- Bottom Branding Overlay -->
                        <div class="position-relative text-white" style="z-index: 10;">
                            <h5 class="fw-bold mb-1">Enterprise Department & Task Management</h5>
                            <p class="small text-light opacity-75 mb-0">Clean Architecture .NET 8 • Multi-Role RBAC • Audit Log Engine</p>
                        </div>
                    </div>

                    <!-- RIGHT COLUMN: LOGIN FORM -->
                    <div class="col-lg-6 p-4 p-md-5 d-flex flex-column justify-content-between bg-white rounded-end-5" style="min-height: 740px;">
                        <div>
                            <!-- Brand Emblem -->
                            <div class="d-flex align-items-center gap-3 mb-4">
                                <img src="/images/logo.png"
                                     alt="TaskManagement Logo"
                                     class="rounded-4 shadow-sm border"
                                     style="object-fit: cover; width: 55px; height: 55px;" />
                                <div>
                                    <h4 class="fw-bold text-dark mb-0">TaskManagement</h4>
                                    <span class="badge bg-primary bg-opacity-10 text-primary fw-medium px-2 py-1 rounded-pill small">
                                        Enterprise SaaS .NET 8
                                    </span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h3 class="fw-bold text-dark mb-1">Đăng Nhập Hệ Thống</h3>
                                <p class="text-muted small mb-0">Quản trị Dự án, Phân quyền RBAC & Theo dõi Công việc toàn diện.</p>
                            </div>

                            <!-- Seed Demo Accounts Quick Action -->
                            <div class="p-3 mb-4 rounded-4 bg-light border border-primary-subtle">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="fw-bold text-primary small uppercase">⚡ TÀI KHOẢN MẪU DÙNG THỬ (DEMO SEED)</span>
                                    <span class="text-muted text-xs">Click điền tự động</span>
                                </div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <button type="button" class="btn btn-outline-primary btn-sm w-100 text-start p-2 rounded-3" onclick="fillAdmin()">
                                            <div class="fw-bold text-xs">👑 Admin System</div>
                                            <div class="text-muted font-monospace text-xs text-truncate">admin@taskflow.com</div>
                                        </button>
                                    </div>
                                    <div class="col-6">
                                        <button type="button" class="btn btn-outline-success btn-sm w-100 text-start p-2 rounded-3" onclick="fillManager()">
                                            <div class="fw-bold text-xs">👤 Dept Manager</div>
                                            <div class="text-muted font-monospace text-xs text-truncate">manager@taskflow.com</div>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Login Form -->
                            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" id="loginForm">
                                @Html.AntiForgeryToken()

                                <!-- Email Input -->
                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label fw-semibold text-dark small">Địa Chỉ Email <span class="text-danger">*</span></label>
                                    <div class="input-group bg-light rounded-4 border border-light-subtle overflow-hidden">
                                        <span class="input-group-text bg-transparent border-0 ps-3 text-muted">
                                            <i class="bi bi-envelope-fill"></i>
                                        </span>
                                        <input asp-for="Email"
                                               id="emailInput"
                                               class="form-control form-control-lg bg-transparent border-0 fs-6 py-2"
                                               placeholder="admin@taskflow.com"
                                               required />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <!-- Password Input -->
                                <div class="mb-4">
                                    <label asp-for="Password" class="form-label fw-semibold text-dark small">Mật Khẩu <span class="text-danger">*</span></label>
                                    <div class="input-group bg-light rounded-4 border border-light-subtle overflow-hidden">
                                        <span class="input-group-text bg-transparent border-0 ps-3 text-muted">
                                            <i class="bi bi-key-fill"></i>
                                        </span>
                                        <input asp-for="Password"
                                               id="passwordInput"
                                               type="password"
                                               class="form-control form-control-lg bg-transparent border-0 fs-6 py-2"
                                               placeholder="••••••••"
                                               required />
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <!-- Submit Button -->
                                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-4 fw-bold py-2.5 shadow-sm">
                                    ĐĂNG NHẬP HỆ THỐNG <i class="bi bi-arrow-right-short ms-1 fs-5"></i>
                                </button>
                            </form>
                        </div>

                        <!-- Footer -->
                        <div class="text-center text-muted small pt-3 border-top mt-4">
                            © 2026 TaskManagement System. Developed by Phạm Tấn Tài (FPT Aptech Software Engineering).
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleAudio() {
        const video = document.getElementById('introVideo');
        const icon = document.getElementById('soundIcon');
        if (video && icon) {
            video.muted = !video.muted;
            if (video.muted) {
                icon.className = 'bi bi-volume-mute-fill fs-5';
            } else {
                icon.className = 'bi bi-volume-up-fill fs-5 text-warning';
            }
        }
    }

    function fillAdmin() {
        document.getElementById('emailInput').value = 'admin@taskflow.com';
        document.getElementById('passwordInput').value = 'admin123';
    }

    function fillManager() {
        document.getElementById('emailInput').value = 'manager@taskflow.com';
        document.getElementById('passwordInput').value = 'manager123';
    }
</script>
