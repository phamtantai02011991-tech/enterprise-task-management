@model TaskManagementWeb.ViewModels.Account.RegisterViewModel

@{
    ViewData["Title"] = "Đăng Ký Tài Khoản Mới";
}

<div class="container-fluid px-lg-5 py-3 my-auto">
    <div class="row justify-content-center align-items-center">
        <div class="col-xxl-11 col-12">
            <div class="card border-0 shadow-2xl rounded-5 overflow-hidden bg-white" style="min-height: 760px;">
                <div class="row g-0 h-100" style="min-height: 760px;">
                    
                    <!-- ==============================================
                         CỘT TRÁI: VIDEO INTRO (FULL CHIỀU CAO 760PX, 10S LOOP)
                         ============================================== -->
                    <div class="col-lg-6 position-relative d-flex flex-column justify-content-between overflow-hidden rounded-start-5"
                         style="min-height: 760px; background: radial-gradient(circle at center, #1e293b 0%, #090d16 100%);">
                        
                        <!-- Video Player (Hiển thị 100% khung hình chuẩn gốc không bị cắt xén, chạy lặp 10s) -->
                        <video id="introVideoRegister"
                               src="/videos/intro.mp4"
                               class="w-100 h-100 position-absolute top-0 start-0"
                               style="object-fit: contain;"
                               autoplay
                               loop
                               muted
                               playsinline
                               preload="auto"
                               poster="/images/logo.png">
                            <source src="/videos/intro.mp4" type="video/mp4" />
                            <source src="~/videos/intro.mp4" type="video/mp4" />
                        </video>

                        <!-- Top Controls: Badge 10s Loop & Sound Toggle -->
                        <div class="position-relative p-4 w-100 d-flex justify-content-between align-items-center" style="z-index: 5;">
                            <span class="badge bg-danger rounded-pill px-3 py-2 shadow-lg d-flex align-items-center gap-2 fs-7">
                                <span class="spinner-grow spinner-grow-sm text-light" style="width: 8px; height: 8px;" role="status"></span>
                                INTRO DEMO • 10S LOOP
                            </span>
                            <button type="button"
                                    id="toggleSoundBtnRegister"
                                    class="btn btn-dark bg-opacity-75 text-white border-0 rounded-circle shadow-lg d-flex align-items-center justify-content-center"
                                    style="width: 42px; height: 42px;"
                                    title="Bật/Tắt âm thanh"
                                    onclick="toggleAudioRegister()">
                                <i class="bi bi-volume-mute-fill fs-5" id="soundIconRegister"></i>
                            </button>
                        </div>

                        <!-- Bottom Area: Hoàn toàn trong suốt để video và logo hiển thị trọn vẹn -->
                        <div class="position-relative p-4 w-100" style="z-index: 5; pointer-events: none;">
                            <!-- Giữ trống để video hiển thị 100% không bị che khuất -->
                        </div>

                    </div>

                    <!-- ==============================================
                         CỘT PHẢI: FORM ĐĂNG KÝ (REGISTER FORM)
                         ============================================== -->
                    <div class="col-lg-6 p-4 p-md-5 d-flex flex-column justify-content-between bg-white rounded-end-5" style="min-height: 760px;">
                        <div>
                            <!-- Brand & Emblem -->
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <img src="~/images/logo.png"
                                     alt="TaskManagement Logo"
                                     class="rounded-4 shadow-sm border"
                                     style="object-fit: cover; width: 65px; height: 65px;" />
                                <div>
                                    <h4 class="fw-bold text-dark mb-0">TaskManagement</h4>
                                    <span class="badge bg-primary bg-opacity-10 text-primary fw-medium px-2 py-1 rounded-pill small">
                                        Enterprise SaaS Platform
                                    </span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <h2 class="fw-bold text-dark mb-1">Tạo Tài Khoản Mới</h2>
                                <p class="text-muted small mb-0">Đăng ký tham gia nền tảng Quản trị Dự án & Phân công Công việc.</p>
                            </div>

                            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
                            {
                                <div class="alert alert-danger rounded-4 border-0 shadow-xs small py-2 px-3 mb-3 d-flex align-items-center">
                                    <i class="bi bi-exclamation-triangle-fill me-2 fs-6"></i>
                                    <div>@Html.ValidationSummary(true, "", new { @class = "mb-0 list-unstyled" })</div>
                                </div>
                            }

                            <!-- Register Form -->
                            <form asp-action="Register" method="post" id="registerForm">
                                @Html.AntiForgeryToken()

                                <!-- Full Name Input -->
                                <div class="mb-3">
                                    <label asp-for="FullName" class="form-label fw-semibold text-dark small">Họ Và Tên <span class="text-danger">*</span></label>
                                    <div class="input-group bg-light rounded-4 border border-light-subtle overflow-hidden">
                                        <span class="input-group-text bg-transparent border-0 ps-3 text-muted">
                                            <i class="bi bi-person-fill"></i>
                                        </span>
                                        <input asp-for="FullName"
                                               class="form-control form-control-lg bg-transparent border-0 fs-6 py-2"
                                               placeholder="Nguyễn Văn A"
                                               required />
                                    </div>
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <!-- Email Input -->
                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label fw-semibold text-dark small">Địa Chỉ Email <span class="text-danger">*</span></label>
                                    <div class="input-group bg-light rounded-4 border border-light-subtle overflow-hidden">
                                        <span class="input-group-text bg-transparent border-0 ps-3 text-muted">
                                            <i class="bi bi-envelope-fill"></i>
                                        </span>
                                        <input asp-for="Email"
                                               class="form-control form-control-lg bg-transparent border-0 fs-6 py-2"
                                               placeholder="name@taskflow.com"
                                               required />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <!-- Password Input with Eye Toggle -->
                                <div class="mb-3">
                                    <label asp-for="Password" class="form-label fw-semibold text-dark small">Mật Khẩu <span class="text-danger">*</span></label>
                                    <div class="position-relative">
                                        <span class="position-absolute top-50 start-0 translate-middle-y ps-3 text-muted" style="z-index: 5;">
                                            <i class="bi bi-key-fill fs-6"></i>
                                        </span>
                                        <input asp-for="Password"
                                               id="registerPasswordInput"
                                               type="password"
                                               class="form-control form-control-lg bg-light border-0 rounded-4 fs-6 py-2 shadow-sm"
                                               style="padding-left: 2.75rem; padding-right: 3.25rem;"
                                               placeholder="••••••••"
                                               required />
                                        <button type="button"
                                                id="toggleRegisterPassBtn"
                                                onclick="toggleRegisterPassword()"
                                                class="btn btn-link position-absolute top-50 end-0 translate-middle-y text-muted text-decoration-none pe-3 border-0 d-flex align-items-center"
                                                style="z-index: 5; cursor: pointer;"
                                                title="Ẩn / Hiện Mật Khẩu">
                                            <i class="bi bi-eye-slash-fill fs-5 text-secondary" id="toggleRegisterPassIcon"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <!-- Confirm Password Input with Eye Toggle -->
                                <div class="mb-3">
                                    <label asp-for="ConfirmPassword" class="form-label fw-semibold text-dark small">Xác Nhận Mật Khẩu <span class="text-danger">*</span></label>
                                    <div class="position-relative">
                                        <span class="position-absolute top-50 start-0 translate-middle-y ps-3 text-muted" style="z-index: 5;">
                                            <i class="bi bi-shield-lock-fill fs-6"></i>
                                        </span>
                                        <input asp-for="ConfirmPassword"
                                               id="confirmPasswordInput"
                                               type="password"
                                               class="form-control form-control-lg bg-light border-0 rounded-4 fs-6 py-2 shadow-sm"
                                               style="padding-left: 2.75rem; padding-right: 3.25rem;"
                                               placeholder="••••••••"
                                               required />
                                        <button type="button"
                                                id="toggleConfirmPassBtn"
                                                onclick="toggleConfirmPassword()"
                                                class="btn btn-link position-absolute top-50 end-0 translate-middle-y text-muted text-decoration-none pe-3 border-0 d-flex align-items-center"
                                                style="z-index: 5; cursor: pointer;"
                                                title="Ẩn / Hiện Mật Khẩu Xác Nhận">
                                            <i class="bi bi-eye-slash-fill fs-5 text-secondary" id="toggleConfirmPassIcon"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>

                                <button type="submit"
                                        class="btn btn-primary btn-lg w-100 rounded-pill fs-6 fw-bold shadow-sm py-3 mt-2">
                                    <i class="bi bi-person-plus-fill me-2"></i> Đăng Ký Tài Khoản Ngay
                                </button>
                            </form>
                        </div>

                        <!-- Footer disclaimer & Login link -->
                        <div class="mt-3 pt-3 border-top">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                <span class="text-muted small">
                                    Đã có tài khoản trên hệ thống?
                                </span>
                                <a asp-action="Login" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-semibold">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập ngay
                                </a>
                            </div>
                            <div class="bg-light p-2 rounded-4 small text-muted border border-light-subtle d-flex align-items-center gap-2">
                                <i class="bi bi-shield-check text-success fs-5"></i>
                                <span class="fs-8">
                                    Tài khoản đăng ký mới sẽ mặc định là <strong>Nhân viên (Employee)</strong>. Quyền Manager và Admin do Quản trị viên phân bổ.
                                </span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Toggle Register Password
        function toggleRegisterPassword() {
            const passInput = document.getElementById('registerPasswordInput');
            const icon = document.getElementById('toggleRegisterPassIcon');
            if (passInput && icon) {
                if (passInput.type === 'password') {
                    passInput.type = 'text';
                    icon.className = 'bi bi-eye-fill text-primary fs-5';
                } else {
                    passInput.type = 'password';
                    icon.className = 'bi bi-eye-slash-fill text-secondary fs-5';
                }
            }
        }

        // Toggle Confirm Password
        function toggleConfirmPassword() {
            const passInput = document.getElementById('confirmPasswordInput');
            const icon = document.getElementById('toggleConfirmPassIcon');
            if (passInput && icon) {
                if (passInput.type === 'password') {
                    passInput.type = 'text';
                    icon.className = 'bi bi-eye-fill text-primary fs-5';
                } else {
                    passInput.type = 'password';
                    icon.className = 'bi bi-eye-slash-fill text-secondary fs-5';
                }
            }
        }

        // Toggle Sound for Video
        function toggleAudioRegister() {
            const video = document.getElementById('introVideoRegister');
            const icon = document.getElementById('soundIconRegister');
            if (video && icon) {
                video.muted = !video.muted;
                if (video.muted) {
                    icon.className = 'bi bi-volume-mute-fill fs-5';
                } else {
                    icon.className = 'bi bi-volume-up-fill text-warning fs-5';
                }
            }
        }

        // Ensure Video Plays Smoothly on Loop
        document.addEventListener('DOMContentLoaded', function() {
            const video = document.getElementById('introVideoRegister');
            if (video) {
                video.play().catch(function() {
                    video.muted = true;
                    video.play();
                });
            }
        });
    </script>
}