@model TaskManagementWeb.Models.ViewModels.Admin.UserListViewModel
@{
    ViewData["Title"] = "Quản Lý Người Dùng";
    ViewData["ActivePage"] = "Users";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1">Quản Lý Người Dùng & Phân Quyền</h3>
        <p class="text-muted mb-0">Danh sách tài khoản nhân sự, phân quyền vai trò (Role) và gán phòng ban.</p>
    </div>
    <a asp-area="Admin" asp-controller="User" asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
        <i class="bi bi-person-plus-fill me-2"></i> Thêm Người Dùng Mới
    </a>
</div>

<!-- Filter & Search Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <form method="get" asp-area="Admin" asp-controller="User" asp-action="Index" class="row g-3 align-items-center">
            <div class="col-md-4">
                <label class="form-label fw-semibold text-secondary fs-7">Tìm kiếm</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="searchKey" value="@Model.SearchKey" class="form-control bg-light border-start-0" placeholder="Nhập tên hoặc email..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold text-secondary fs-7">Lọc theo Vai Trò</label>
                <select name="roleIdFilter" class="form-select bg-light">
                    <option value="">-- Tất cả Vai Trò --</option>
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <option value="@role.Id" selected="@(Model.RoleIdFilter == role.Id)">@role.RoleName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold text-secondary fs-7">Lọc theo Phòng Ban</label>
                <select name="departmentIdFilter" class="form-select bg-light">
                    <option value="">-- Tất cả Phòng Ban --</option>
                    @foreach (var dept in Model.AvailableDepartments)
                    {
                        <option value="@dept.Id" selected="@(Model.DepartmentIdFilter == dept.Id)">[@dept.Code] @dept.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-dark w-100 rounded-3">Lọc</button>
                <a asp-area="Admin" asp-controller="User" asp-action="Index" class="btn btn-outline-secondary rounded-3" title="Đặt lại"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Họ và Tên</th>
                        <th>Email</th>
                        <th>Vai Trò (Role)</th>
                        <th>Phòng Ban</th>
                        <th>Trạng Thái</th>
                        <th>Ngày Tạo</th>
                        <th class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users.Any())
                    {
                        @foreach (var user in Model.Users)
                        {
                            <tr class="@(user.IsActive ? "" : "table-light opacity-75")">
                                <td class="ps-4 fw-semibold text-dark">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary bg-opacity-10 text-primary fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                            @user.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div>@user.FullName</div>
                                            @if (!user.IsActive)
                                            {
                                                <small class="text-danger fs-8 fw-normal"><i class="bi bi-lock me-1"></i>Tài khoản đang bị khóa</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="badge @(user.RoleName == "Admin" ? "bg-danger" : user.RoleName == "Manager" ? "bg-warning text-dark" : "bg-info text-white") rounded-pill px-3 py-1">
                                        @user.RoleName
                                    </span>
                                </td>
                                <td>
                                    @if (user.DepartmentNames.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var deptName in user.DepartmentNames)
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-2 py-1 fs-7">
                                                    <i class="bi bi-building me-1"></i>@deptName
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-7"><i class="bi bi-dash-circle me-1"></i>Chưa phân phòng</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-1">
                                            <i class="bi bi-lock-fill me-1"></i>Đã khóa
                                        </span>
                                    }
                                </td>
                                <td class="text-muted fs-7">@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-area="Admin" asp-controller="User" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary rounded-3" title="Chỉnh sửa & Phân quyền">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <!-- Button trigger Reset Password Modal -->
                                        <button type="button" class="btn btn-sm btn-outline-warning rounded-3" data-bs-toggle="modal" data-bs-target="#resetModal-@user.Id" title="Đặt lại Mật khẩu">
                                            <i class="bi bi-key-fill"></i>
                                        </button>

                                        <!-- Button trigger Toggle Status Form (Soft Delete / Safe State) -->
                                        <form asp-area="Admin" asp-controller="User" asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" onsubmit="return confirm('@(user.IsActive ? "Bạn có chắc chắn muốn KHÓA / VÔ HIỆU HÓA tài khoản này? (Dữ liệu dự án và lịch sử được bảo toàn nguyên vẹn)" : "Bạn có chắc chắn muốn MỞ KHÓA / KÍCH HOẠT LẠI tài khoản này?")');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            @if (user.IsActive)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Khóa tài khoản (Bảo toàn dữ liệu)">
                                                    <i class="bi bi-lock-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-3" title="Mở khóa tài khoản">
                                                    <i class="bi bi-unlock-fill"></i>
                                                </button>
                                            }
                                        </form>
                                    </div>

                                    <!-- Reset Password Modal -->
                                    <div class="modal fade text-start" id="resetModal-@user.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content rounded-4 border-0">
                                                <form asp-area="Admin" asp-controller="User" asp-action="ResetPassword" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <div class="modal-header border-0 pb-0">
                                                        <h5 class="modal-heading fw-bold">Đặt lại Mật khẩu cho @user.FullName</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body py-3">
                                                        <p class="text-muted fs-7">Nhập mật khẩu mới cấp cho người dùng <strong>@user.Email</strong>:</p>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold">Mật khẩu mới</label>
                                                            <input type="password" name="newPassword" class="form-control rounded-3" required minlength="6" placeholder="Ít nhất 6 ký tự..." />
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0">
                                                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                                                        <button type="submit" class="btn btn-warning text-dark fw-bold rounded-pill px-4">Xác nhận đổi</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Không tìm thấy tài khoản người dùng phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center p-4 border-top">
                <div class="text-muted fs-7">Hiển thị trang @Model.CurrentPage / @Model.TotalPages (Tổng số @Model.TotalItems kết quả)</div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { searchKey = Model.SearchKey, roleIdFilter = Model.RoleIdFilter, departmentIdFilter = Model.DepartmentIdFilter, page = Model.CurrentPage - 1 })">Trước</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { searchKey = Model.SearchKey, roleIdFilter = Model.RoleIdFilter, departmentIdFilter = Model.DepartmentIdFilter, page = i })">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { searchKey = Model.SearchKey, roleIdFilter = Model.RoleIdFilter, departmentIdFilter = Model.DepartmentIdFilter, page = Model.CurrentPage + 1 })">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
