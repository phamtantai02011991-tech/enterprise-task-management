@model TaskManagementWeb.Models.ViewModels.Admin.AuditLogListViewModel
@{
    ViewData["Title"] = "Nhật Ký Hệ Thống (Audit Logs)";
    ViewData["ActivePage"] = "AuditLogs";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1">Lịch Sử Nhật Ký Hoạt Động (Audit Logs)</h3>
        <p class="text-muted mb-0">Theo dõi chi tiết các thao tác tạo, cập nhật, xóa dữ liệu và bảo mật trong toàn bộ hệ thống.</p>
    </div>
</div>

<!-- Filter & Search Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <form method="get" asp-area="Admin" asp-controller="AuditLog" asp-action="Index" class="row g-3 align-items-center">
            <div class="col-md-3">
                <label class="form-label fw-semibold text-secondary fs-7">Từ khóa tìm kiếm</label>
                <input type="text" name="searchKey" value="@Model.SearchKey" class="form-control bg-light" placeholder="Tên người dùng, entity, chi tiết..." />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold text-secondary fs-7">Hành động</label>
                <select name="actionFilter" class="form-select bg-light">
                    <option value="">-- Tất cả --</option>
                    @foreach (var act in Model.AvailableActions)
                    {
                        <option value="@act" selected="@(Model.ActionFilter?.ToUpper() == act)">@act</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold text-secondary fs-7">Từ ngày</label>
                <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control bg-light" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold text-secondary fs-7">Đến ngày</label>
                <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control bg-light" />
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-dark w-100 rounded-3"><i class="bi bi-filter me-1"></i> Lọc Logs</button>
                <a asp-area="Admin" asp-controller="AuditLog" asp-action="Index" class="btn btn-outline-secondary rounded-3" title="Đặt lại"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Logs Table -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Thời Gian</th>
                        <th>Người Thực Hiện</th>
                        <th>Hành Động</th>
                        <th>Đối Tượng (Entity)</th>
                        <th>Chi Tiết Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Logs.Any())
                    {
                        @foreach (var log in Model.Logs)
                        {
                            <tr>
                                <td class="ps-4 text-muted font-monospace fs-7">#@log.Id</td>
                                <td class="text-secondary fs-7">@log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td class="fw-semibold text-dark">
                                    <i class="bi bi-person-circle me-1 text-primary"></i>@log.UserName
                                </td>
                                <td>
                                    <span class="badge @(log.Action == "CREATE" ? "bg-success" : log.Action == "UPDATE" ? "bg-primary" : log.Action == "DELETE" ? "bg-danger" : log.Action == "RESET_PASSWORD" ? "bg-warning text-dark" : "bg-secondary") rounded-pill px-3 py-1">
                                        @log.Action
                                    </span>
                                </td>
                                <td><span class="fw-bold text-dark">@log.EntityName</span></td>
                                <td class="text-muted">@log.Details</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-journal-x fs-1 d-block mb-2"></i>
                                Không có nhật ký thao tác nào phù hợp với bộ lọc.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center p-4 border-top">
                <div class="text-muted fs-7">Hiển thị trang @Model.CurrentPage / @Model.TotalPages (Tổng số @Model.TotalItems log)</div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { searchKey = Model.SearchKey, actionFilter = Model.ActionFilter, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd"), page = Model.CurrentPage - 1 })">Trước</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { searchKey = Model.SearchKey, actionFilter = Model.ActionFilter, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd"), page = i })">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { searchKey = Model.SearchKey, actionFilter = Model.ActionFilter, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd"), page = Model.CurrentPage + 1 })">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
