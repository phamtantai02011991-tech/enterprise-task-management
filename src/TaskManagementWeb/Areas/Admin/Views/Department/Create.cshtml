@model TaskManagementWeb.Models.ViewModels.Admin.DepartmentFormViewModel
@{
    ViewData["Title"] = "Thêm Phòng Ban Mới";
    ViewData["ActivePage"] = "Departments";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="fw-bold mb-1">Thêm Phòng Ban Mới</h3>
                <p class="text-muted mb-0">Tạo mã phòng ban và khai báo cơ cấu tổ chức.</p>
            </div>
            <a asp-area="Admin" asp-controller="Department" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-area="Admin" asp-controller="Department" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" id="deptName" class="form-control rounded-3" placeholder="Nhập tên phòng ban đầy đủ (Ví dụ: Phòng Kế Toán)..." autofocus />
                        <span asp-validation-for="Name" class="text-danger fs-7"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Code" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="Code" id="deptCode" class="form-control font-monospace text-uppercase" placeholder="Mã tự động tạo (hoặc nhập mã riêng)..." />
                            <button type="button" id="btnAutoCode" class="btn btn-outline-secondary" title="Tự động tạo mã dựa trên tên">
                                <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Tự động tạo mã
                            </button>
                        </div>
                        <div class="form-text fs-7 text-muted">Hệ thống sẽ tự động gợi ý mã phòng ban khi bạn gõ tên. Có thể tùy chỉnh nếu cần.</div>
                        <span asp-validation-for="Code" class="text-danger fs-7"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="4" placeholder="Mô tả chức năng, nhiệm vụ phòng ban..."></textarea>
                        <span asp-validation-for="Description" class="text-danger fs-7"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-3 pt-3 border-top">
                        <a asp-area="Admin" asp-controller="Department" asp-action="Index" class="btn btn-light rounded-pill px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">Tạo Phòng Ban</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const nameInput = document.getElementById("deptName");
            const codeInput = document.getElementById("deptCode");
            const btnAutoCode = document.getElementById("btnAutoCode");
            let isUserCustomized = false;

            codeInput.addEventListener("input", function() {
                if (codeInput.value.trim() !== "") {
                    isUserCustomized = true;
                } else {
                    isUserCustomized = false;
                }
            });

            function generateCode(str) {
                if (!str) return "";
                // Unaccent
                str = str.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
                str = str.replace(/[^a-zA-Z0-9\s]/g, "");
                const words = str.trim().split(/\s+/).filter(w => w.length > 0);
                if (words.length === 0) return "";
                let initials = words.map(w => w[0].toUpperCase()).join("");
                if (initials.length === 1 && words[0].length >= 3) {
                    initials = words[0].substring(0, 3).toUpperCase();
                }
                return initials;
            }

            nameInput.addEventListener("input", function () {
                if (!isUserCustomized) {
                    codeInput.value = generateCode(nameInput.value);
                }
            });

            btnAutoCode.addEventListener("click", function () {
                isUserCustomized = false;
                codeInput.value = generateCode(nameInput.value);
            });
        });
    </script>
}
