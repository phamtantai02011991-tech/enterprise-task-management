@using TaskManagementWeb.Models.Entities
@model Announcement

@{
    ViewData["Title"] = "Chỉnh sửa Thông Báo Hệ Thống";
    ViewData["ActivePage"] = "Announcement";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-pencil-square text-warning me-2"></i>Chỉnh sửa Thông Báo
        </h2>
        <p class="text-muted mb-0">Cập nhật nội dung, loại thông báo hoặc trạng thái phát sóng.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedByUserId" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Tiêu Đề Thông Báo <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control form-control-lg rounded-3" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Type" class="form-label fw-semibold">Phân Loại Thông Báo</label>
                            <select asp-for="Type" class="form-select">
                                <option value="Info">ℹ️ Thông Tin (Info)</option>
                                <option value="Warning">⚠️ Cảnh Báo (Warning)</option>
                                <option value="Urgent">🚨 Khẩn Cấp (Urgent)</option>
                                <option value="Success">✅ Thành Công / Tin Vui (Success)</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExpiryDate" class="form-label fw-semibold">Ngày Hết Hạn Hiển Thị</label>
                            <input asp-for="ExpiryDate" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Content" class="form-label fw-semibold">Nội Dung Chi Tiết <span class="text-danger">*</span></label>
                        <textarea asp-for="Content" class="form-control" rows="5" required></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" id="switchActive" />
                                <label class="form-check-label fw-semibold" for="switchActive">Đang phát sóng</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsPinned" id="switchPinned" />
                                <label class="form-check-label fw-semibold" for="switchPinned">Ghim lên đầu trang chủ</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">Hủy</a>
                        <button type="submit" class="btn btn-warning rounded-pill px-5 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Lưu Thay Đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
