@using TaskManagementWeb.ViewModels.Manager
@using TaskManagementWeb.Models.Enums
@model ProjectCreateUpdateViewModel

@{
    ViewData["Title"] = $"Chỉnh sửa Dự án [{Model.ProjectCode}]";
    ViewData["ActivePage"] = "Projects";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-pencil-square text-warning me-2"></i>Chỉnh Sửa Thông Tin Dự Án (Admin)
        </h2>
        <p class="text-muted mb-0">Cập nhật mã dự án, điều lệ, trưởng dự án, ngày tháng và đội ngũ thực hiện.</p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Row 1: Code & Title -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="ProjectCode" class="form-label fw-semibold">Mã Dự Án (Project Code) <span class="text-danger">*</span></label>
                            <input asp-for="ProjectCode" class="form-control font-monospace fw-bold" required />
                            <span asp-validation-for="ProjectCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label fw-semibold">Tên Dự Án <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Row 2: Description -->
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">Mô Tả & Mục Tiêu Dự Án</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>

                    <!-- Row 3: Manager Assignment, Status & Priority -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="ManagerId" class="form-label fw-semibold text-primary">
                                <i class="bi bi-person-badge me-1"></i>Trưởng Dự Án (Manager) <span class="text-danger">*</span>
                            </label>
                            <select asp-for="ManagerId" class="form-select border-primary" required>
                                <option value="">-- Chọn Trưởng Dự Án --</option>
                                @if (Model.AvailableManagers != null)
                                {
                                    @foreach (var mgr in Model.AvailableManagers)
                                    {
                                        <option value="@mgr.Value">@mgr.Text</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold">Trạng Thái Vòng Đời</label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ProjectStatus>()"></select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Priority" class="form-label fw-semibold">Mức Độ Ưu Tiên</label>
                            <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<ProjectPriority>()"></select>
                        </div>
                    </div>

                    <!-- Row 4: Dates & Progress -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="StartDate" class="form-label fw-semibold">Ngày Bắt Đầu <span class="text-danger">*</span></label>
                            <input asp-for="StartDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EndDate" class="form-label fw-semibold">Ngày Hạn Chót <span class="text-danger">*</span></label>
                            <input asp-for="EndDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Progress" class="form-label fw-semibold">Tiến Độ (%)</label>
                            <input asp-for="Progress" type="number" min="0" max="100" class="form-control" />
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light rounded-pill px-4">Hủy</a>
                        <button type="submit" class="btn btn-warning rounded-pill px-5 shadow-sm text-dark fw-semibold">
                            <i class="bi bi-check2-circle me-1"></i> Lưu Thay Đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
