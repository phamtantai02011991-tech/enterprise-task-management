@model IEnumerable<TaskManagementWeb.Models.Entities.TaskItem>

@{
    ViewData["Title"] = "Quản lý Công việc (Tasks)";
    int? projectId = ViewBag.ProjectId as int?;
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Quản lý Công việc</h1>
    
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><i class="fas fa-tasks me-1"></i> Danh sách Task</div>
            @if (projectId.HasValue)
            {
                <a asp-action="Create" asp-route-projectId="@projectId" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> Thêm Task Mới
                </a>
            }
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Tiêu đề</th>
                        <th>Độ ưu tiên</th>
                        <th>Trạng thái</th>
                        <th>Deadline</th>
                        <th>Người thực hiện</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td>@item.Title</td>
                            <td>
                                <span class="badge bg-info text-dark">@item.Priority</span>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@item.Status</span>
                            </td>
                            <td>@item.Deadline.ToString("dd/MM/yyyy")</td>
                            <td>@(item.AssignedUser?.FullName ?? "Chưa phân công")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Chi tiết</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            
            @if (projectId.HasValue)
            {
                <a asp-controller="Project" asp-action="Details" asp-route-id="@projectId" class="btn btn-secondary mt-3">Quay lại Dự án</a>
            }
        </div>
    </div>
</div>