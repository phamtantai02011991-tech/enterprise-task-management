@using TaskManagementWeb.Models.Enums
@model TaskManagementWeb.ViewModels.Manager.ProjectCreateUpdateViewModel

@{
    ViewData["Title"] = "Khởi tạo Dự án Mới";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-folder-plus text-primary me-2"></i>Khởi tạo Dự án Mới
            </h2>
            <p class="text-muted mb-0">Điền thông tin chi tiết để thiết lập dự án, phân công trưởng dự án và thành viên.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- General Information -->
                        <h5 class="fw-bold text-primary mb-3 pb-2 border-bottom">
                            <i class="bi bi-info-circle me-2"></i>Thông tin chung
                        </h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="ProjectCode" class="form-label fw-semibold">Mã Dự Án <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-hash"></i></span>
                                    <input asp-for="ProjectCode" class="form-control" placeholder="VD: PRJ-2026-001" required />
                                </div>
                                <span asp-validation-for="ProjectCode" class="text-danger small"></span>
                            </div>

                            <div class="col-md-8">
                                <label asp-for="Title" class="form-label fw-semibold">Tên Dự Án <span class="text-danger">*</span></label>
                                <input asp-for="Title" class="form-control" placeholder="Nhập tên dự án..." required />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">Mô Tả Chi Tiết</label>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Mục tiêu, phạm vi và yêu cầu của dự án..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Schedule & Priority -->
                        <h5 class="fw-bold text-primary mb-3 pb-2 border-bottom">
                            <i class="bi bi-calendar-check me-2"></i>Kế hoạch & Trạng thái
                        </h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label fw-semibold">Ngày Bắt Đầu <span class="text-danger">*</span></label>
                                <input asp-for="StartDate" type="date" class="form-control" required />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label fw-semibold">Ngày Kết Thúc (Deadline) <span class="text-danger">*</span></label>
                                <input asp-for="EndDate" type="date" class="form-control" required />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold">Trạng Thái Khởi Tạo</label>
                                <select asp-for="Status" asp-items="Html.GetEnumSelectList<ProjectStatus>()" class="form-select"></select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Priority" class="form-label fw-semibold">Mức Độ Ưu Tiên</label>
                                <select asp-for="Priority" asp-items="Html.GetEnumSelectList<ProjectPriority>()" class="form-select"></select>
                                <span asp-validation-for="Priority" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Team & Manager Assignment -->
                        <h5 class="fw-bold text-primary mb-3 pb-2 border-bottom">
                            <i class="bi bi-people me-2"></i>Phân công Quản lý & Nhân sự
                        </h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-12">
                                <label asp-for="ManagerId" class="form-label fw-semibold">Chỉ Định Trưởng Dự Án (Project Manager)</label>
                                <select asp-for="ManagerId" asp-items="Model.AvailableManagers" class="form-select">
                                    <option value="">-- Chọn Trưởng Dự Án --</option>
                                </select>
                                <span asp-validation-for="ManagerId" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Chọn Thành Viên Tham Gia Ban Đầu</label>
                                <div class="card bg-light border-0 p-3 rounded-3" style="max-height: 220px; overflow-y: auto;">
                                    @if (Model.AvailableEmployees != null && Model.AvailableEmployees.Any())
                                    {
                                        <div class="row g-2">
                                            @foreach (var emp in Model.AvailableEmployees)
                                            {
                                                <div class="col-md-6">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" name="SelectedMemberIds" value="@emp.Value" id="emp_@emp.Value" />
                                                        <label class="form-check-label small" for="emp_@emp.Value">
                                                            @emp.Text
                                                        </label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted small mb-0">Chưa có danh sách nhân sự sẵn sàng.</p>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Lưu & Khởi Tạo Dự Án
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}