@model IEnumerable<TaskManagementWeb.Models.Entities.Project>
@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1">Dashboard Quản Lý (Manager)</h3>
        <p class="text-muted mb-0">Thống kê chỉ số dự án, công việc và theo dõi tiến độ nhân sự.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Project" asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Tạo Dự án Mới
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 bg-primary text-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="fs-7 text-white-50 text-uppercase fw-semibold">Tổng số Dự án</div>
                    <div class="fs-2 fw-bold mt-1">@ViewBag.TotalProjects</div>
                </div>
                <div class="bg-white bg-opacity-20 rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-folder-fill fs-3 text-white"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 bg-warning text-dark p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="fs-7 text-dark-50 text-uppercase fw-semibold">Tổng số Task</div>
                    <div class="fs-2 fw-bold mt-1">@ViewBag.TotalTasks</div>
                </div>
                <div class="bg-dark bg-opacity-10 rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-list-task fs-3 text-dark"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 bg-success text-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="fs-7 text-white-50 text-uppercase fw-semibold">Task hoàn thành</div>
                    <div class="fs-2 fw-bold mt-1">@ViewBag.CompletedTasks</div>
                </div>
                <div class="bg-white bg-opacity-20 rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-check-circle-fill fs-3 text-white"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 bg-danger text-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="fs-7 text-white-50 text-uppercase fw-semibold">Tổng số Nhân sự</div>
                    <div class="fs-2 fw-bold mt-1">@ViewBag.TotalEmployees</div>
                </div>
                <div class="bg-white bg-opacity-20 rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-people-fill fs-3 text-white"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Managed Projects -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0"><i class="bi bi-folder2-open me-2 text-primary"></i> Dự án đang phụ trách</h5>
        <a asp-controller="Project" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">Xem tất cả</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Tên Dự Án</th>
                        <th>Ngày Bắt Đầu</th>
                        <th>Ngày Kết Thúc</th>
                        <th>Người Tạo</th>
                        <th class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var project in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-folder-fill text-primary"></i>
                                        <span>@project.Title</span>
                                    </div>
                                </td>
                                <td>@project.StartDate.ToString("dd/MM/yyyy")</td>
                                <td>@project.EndDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-10 text-dark border">
                                        @(project.CreatedByUser?.FullName ?? "Manager")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-controller="Project" asp-action="Details" asp-route-id="@project.Id" class="btn btn-sm btn-outline-primary rounded-3">
                                        <i class="bi bi-eye-fill me-1"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                Chưa có dự án nào thuộc quyền quản lý của bạn.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>