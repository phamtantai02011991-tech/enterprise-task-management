@model day04.Models.Product

@{
    ViewData["Title"] = "Edit";
}

<h4>Update Product</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden"  asp-for="Id" />
            <partial name="_pvCreateOrUpdate"/>
            <div class="form-group">
                <label class="control-label">Current Image</label>
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" width="100" height="100" />
                }
                else
                {
                    <span>No Image</span>
                }
                <div class="form-group">
                    <label class="control-label">New File</label>
                    <input type="file" name="image" class="form-control" accept=".gif, .png, .jpg" />
                    <span class="text-danger">.gif, .png, .jpg. Max 2MB</span>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
