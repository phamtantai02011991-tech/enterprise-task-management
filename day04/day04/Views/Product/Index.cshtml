@model day04.ViewModels.ProductIndexViewModel
@{
	ViewData["title"] = "Index";
}
<div class="container">
	<div>
		<h1>Product Management System</h1>
		<div>
			<a asp-action="Create" class="btn btn-success">+ Add New</a>
		</div>
	</div>
	<br/>
	<partial name="_pvProduct" model="Model.Statistics"/>
	<br/>
	<form asp-action="Index" method="get" class="row g-2 align-items-center mb-3">
		<div class="col-auto">
			<input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Search product..." />
		</div>
		<div class="col-auto">
			<button type="submit" class="btn btn-primary">Search</button>
		</div>
	</form>
	<br/>
	<table class="table align-middle">
		<tr>
			<th>Image</th>
			<th>Id</th>
			<th>Product Name</th>
			<th>Category</th>
			<th>Unit Price</th>
			<th>Quantity</th>
			<th>Actions</th>
		</tr>
		@foreach(var product in Model.Products)
		{
			<tr>
				<td>
					@if (!string.IsNullOrEmpty(product.ImagePath))
					{
						<img src="@product.ImagePath" width="80" height="80" class="img-thumbnail" />
					}
					else
					{
						<span>No Image</span>
					}
				</td>
				<td>@product.Id</td>
				<td>@product.Name</td>
				<td>@product.Category</td>
				<td>@product.Price.ToString("N0") VNĐ</td>
				<td>@product.Quantity</td>
				<td>
					<a asp-action="Details" asp-route-id="@product.Id" class="btn btn-info btn-sm">Details</a>
					<a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-warning btn-sm">Edit</a>
					<a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-danger btn-sm">Delete</a>
				</td>
			</tr>
		}
	</table>
</div>