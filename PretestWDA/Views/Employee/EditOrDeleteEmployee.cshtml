@model PretestWDA.Models.tbEmployee

@{
    ViewData["Title"] = "EditOrDeleteEmployee";
}

<div class="container mt-4">
    <div style="border: 1px solid #000; padding: 15px; width: 320px; background-color: #fff;">
        <h5 style="font-weight: bold; margin-bottom: 15px;">Edit or delete Employee</h5>

        <form asp-action="EditOrDeleteEmployee" method="post">
            <div class="mb-2">
                <label asp-for="EmpID"></label><br />
                <input asp-for="EmpID" class="form-control form-control-sm" readonly />
            </div>

            <div class="mb-2">
                <label asp-for="EmpDoB"></label><br />
                <input type="text" name="EmpDoB" value="@Model.EmpDoB.ToString("M/d/yyyy")" class="form-control form-control-sm" />
                <span asp-validation-for="EmpDoB" class="text-danger small"></span>
            </div>

            <div class="mb-2">
                <label asp-for="EmpName"></label><br />
                <input asp-for="EmpName" class="form-control form-control-sm" />
                <span asp-validation-for="EmpName" class="text-danger small"></span>
            </div>

            <div class="mb-2">
                <label asp-for="EmpAddress"></label><br />
                <input asp-for="EmpAddress" class="form-control form-control-sm" />
                <span asp-validation-for="EmpAddress" class="text-danger small"></span>
            </div>

            <div class="mb-2">
                <label asp-for="EmpEmail"></label><br />
                <input asp-for="EmpEmail" class="form-control form-control-sm" />
                <span asp-validation-for="EmpEmail" class="text-danger small"></span>
            </div>

            <div class="mt-3 d-flex align-items-center gap-2">
                <button type="submit" name="submitButton" value="Save" class="btn btn-sm btn-light border px-3">Save</button>
                <button type="submit" name="submitButton" value="Remove" class="btn btn-sm btn-link text-decoration-underline p-0" style="color: purple;" onclick="return confirm('Are you sure you want to remove this employee?');">Remove</button>
            </div>

            @if (!string.IsNullOrEmpty(ViewBag.Message))
            {
                <div class="mt-3 font-weight-bold" style="font-weight: bold;">
                    @ViewBag.Message
                </div>
            }

            <div class="mt-3">
                <a asp-action="ViewEmployeeList" style="color: blue; text-decoration: underline;">Back to List</a>
            </div>
        </form>
    </div>
    <div class="mt-2 text-muted small">Figure 2. EditOrDeleteEmployee page</div>
</div>
